# Required: Groq API key for the LLM agent
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Required: Supabase PostgreSQL connection string
# Use the postgresql+psycopg2 dialect for SQLAlchemy
DATABASE_URL=postgresql+psycopg2://postgres:YOUR-PASSWORD@db.xxxx.supabase.co:5432/postgres
